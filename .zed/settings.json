{
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "language_servers": ["!biome", "!typescript-language-server", "..."],
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "prettier", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
